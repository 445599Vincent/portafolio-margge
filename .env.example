# URL pública opcional (SEO, sitemap y Open Graph). Prioridad:
# NEXT_PUBLIC_SITE_URL → VERCEL_PROJECT_PRODUCTION_URL (Vercel) → URL (Netlify) → localhost.
# Vercel y Netlify inyectan sus variables automáticamente; define esta solo para sobrescribirlas.
NEXT_PUBLIC_SITE_URL=

# Formulario de contacto: "none" | "formspree" | "netlify" | "api"
NEXT_PUBLIC_FORM_PROVIDER=none
# Endpoint para formspree (https://formspree.io/f/xxxx) o para una API propia / Supabase Edge Function
NEXT_PUBLIC_FORM_ENDPOINT=

# Analítica (se activan solo si existe el valor)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
# Código de verificación de Google Search Console (meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=
